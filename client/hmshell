#!/bin/sh
# ==============================================================================
# HMArkPriv Interactive Shell Terminal (client/hmshell)
# ------------------------------------------------------------------------------
# Dedicated interactive terminal console for HarmonyOS 7.0 (HongMeng Microkernel).
# Can be run inside MT Manager Terminal, Termux, or Android Terminal Emulator.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI="${SCRIPT_DIR}/hmpriv_cli.sh"

if [ ! -f "$CLI" ]; then
    # Fallback to standard locations
    for candidate in \
        "/storage/media/100/local/files/Docs/Download/HMArkPriv/hmpriv_cli.sh" \
        "/storage/emulated/0/MyHarmonyOSDevice/Download/HMArkPriv/hmpriv_cli.sh" \
        "/sdcard/MyHarmonyOSDevice/Download/HMArkPriv/hmpriv_cli.sh" \
        "/data/local/tmp/hmpriv/client/hmpriv_cli.sh"
    do
        if [ -f "$candidate" ]; then
            CLI="$candidate"
            break
        fi
    done
fi

clear 2>/dev/null || true
echo "\033[1;36m==================================================================\033[0m"
echo "\033[1;33m  ⚡ HMArkPriv 特权终端机 (HarmonyOS 7.0)\033[0m"
echo "\033[1;30m  UID: 2000 (shell) | 内核: HongMeng Microkernel\033[0m"
echo "\033[1;30m  输入 Shell 命令即时执行 | 输入 'help' 查看快捷指南 | 'exit' 退出\033[0m"
echo "\033[1;36m==================================================================\033[0m"

print_help() {
    cat << 'EOF'
[常用快捷指令与别名]
  wakeup               - 点亮/唤醒屏幕
  suspend / sleep      - 熄灭屏幕休眠
  timeout <ms>         - 屏幕常亮 (如 timeout 3600000 常亮1小时, timeout -r 恢复)
  battery              - 查看电池与充电详细状态
  hotspot              - 切换个人热点
  apps                 - 查看已安装应用包名列表
  top                  - 查看当前前台应用与任务栈 (aa dump -l)
  notification         - 调起卓易通内部隐藏的“通知使用权”设置
  accessibility        - 调起安卓原生“无障碍”设置
  tap <x> <y>          - 模拟屏幕点击 (uinput)
  screenshot <file>    - 截屏 (snapshot_display)
  clear / cls          - 清屏
  exit / quit          - 退出终端机
  
提示：也可直接输入任意系统原生 Shell 指令，如 id, uname -a, ps -ef 等。
EOF
}

while true; do
    printf "\033[1;32m[HMArkPriv:shell]\033[0m# "
    read -r cmd || break
    [ -z "$cmd" ] && continue

    case "$cmd" in
        exit|quit|q)
            echo "已退出 HMArkPriv 终端机。"
            break
            ;;
        clear|cls)
            clear 2>/dev/null || true
            ;;
        help|\?)
            print_help
            ;;
        wakeup)
            sh "$CLI" power-shell wakeup
            ;;
        suspend|sleep)
            sh "$CLI" power-shell suspend
            ;;
        timeout*)
            args="${cmd#timeout}"
            args="$(echo "$args" | sed 's/^[[:space:]]*//')"
            if [ -z "$args" ] || [ "$args" = "-r" ]; then
                sh "$CLI" power-shell timeout -r
            else
                sh "$CLI" power-shell timeout -o "$args"
            fi
            ;;
        battery)
            sh "$CLI" hidumper -s BatteryService
            ;;
        hotspot)
            # Toggle Hotspot
            sh "$CLI" "power-shell wakeup; uinput -T -m 1100 50 1100 900 250; sleep 0.8; uinput -T -c 764 2310; sleep 0.5; uinput -K -d 2 -u 2"
            ;;
        apps)
            sh "$CLI" "bm dump -a | grep bundleName | head -n 40"
            ;;
        top)
            sh "$CLI" "aa dump -l"
            ;;
        notification)
            sh "$CLI" "aa start -b com.android.settings -a com.android.settings.Settings\\\$NotificationAccessSettingsActivity"
            ;;
        accessibility)
            sh "$CLI" "aa start -b com.android.settings -a com.android.settings.Settings\\\$AccessibilitySettingsActivity"
            ;;
        screenshot*)
            target_f="${cmd#screenshot}"
            target_f="$(echo "$target_f" | sed 's/^[[:space:]]*//')"
            target_f="${target_f:-/storage/media/100/local/files/Docs/Download/HMArkPriv/screen.jpeg}"
            sh "$CLI" "snapshot_display -f $target_f"
            echo "截屏已保存至: $target_f"
            ;;
        *)
            sh "$CLI" "$cmd"
            ;;
    esac
done
