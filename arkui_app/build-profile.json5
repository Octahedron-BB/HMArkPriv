{
  // ============================================================================
  // 这是仓库版配置 —— 故意不含 signingConfigs。
  //
  // 【为什么】
  // 签名配置里含本机证书的绝对路径和加密后的口令，对别人毫无用处
  // （p12/cer/p7b 都在各自机器的 ~/.ohos/config 下），提交进公开仓库只是泄露信息。
  //
  // 【怎么用】
  // - 只跑模拟器 / 只要 unsigned HAP：直接 ./build.sh，无需任何签名配置。
  // - 真机安装：把签名配置写到同目录的 build-profile.local.json5
  //   （该文件已被 .gitignore 忽略），build.sh 会自动用它覆盖本文件再构建，
  //   构建结束后还原。也可以直接在 DevEco Studio 里点「自动签名」，让它写进本文件，
  //   但提交前记得把 signingConfigs 段删掉。
  // ============================================================================
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
