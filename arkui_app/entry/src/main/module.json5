{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_desc",
        "icon": "$media:app_icon",
        "label": "$string:entry_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // 【探针】验证普通三方应用（apl=normal）能否收到无障碍事件。
        // type 必须是 "accessibility"；srcEntry 指向继承 AccessibilityExtensionAbility 的类。
        // 用户在「设置 → 辅助功能 → 无障碍」里手动启用后才会被拉起。
        "name": "AdProbeAbility",
        "srcEntry": "./ets/adprobe/AdProbeAbility.ets",
        "type": "accessibility",
        "exported": true,
        "label": "$string:adprobe_label",
        "description": "$string:adprobe_desc",
        "metadata": [
          {
            "name": "ohos.accessibleability",
            "resource": "$profile:adprobe_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:perm_download_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_MEDIA",
        "reason": "$string:perm_media_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.WRITE_MEDIA",
        "reason": "$string:perm_media_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST",
        "reason": "$string:perm_persist_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ]
  }
}
